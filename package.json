{
  "name": "pychess-variants",
  "version": "0.0.2",
  "private": true,
  "description": "free, open-source chess server designed to play chess variants.",
  "repository": {
    "type": "git",
    "url": "https://github.com/pychess/pychess-variants.git"
  },
  "engines": {
    "node": "24.x",
    "yarn": "1.x"
  },
  "main": "static/pychess-variants.js",
  "author": "Bajusz Tamás",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/pychess/pychess-variants/issues"
  },
  "funding": "patreon.com/pychess",
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.20",
    "@pychess/betza": "^0.1.3",
    "@toast-ui/editor": "3.2.2",
    "chessgroundx": "^10.7.5",
    "dompurify": "^3.4.16",
    "fairy-stockfish-nnue.wasm": "^1.1.12",
    "ffish-alice-es6": "^0.0.1",
    "ffish-es6": "^0.7.10",
    "gettext.js": "^2.0.3",
    "highcharts": "^13.1.1",
    "howler": "^2.2.3",
    "idb-keyval": "^6.3.0",
    "mousetrap": "^1.6.5",
    "snabbdom": "^3.6.4"
  },
  "devDependencies": {
    "@jest/globals": "^30",
    "@types/gettext.js": "^2.0.0",
    "@types/howler": "^2.2.13",
    "@types/mousetrap": "^1.6.11",
    "@types/showdown": "^2.0.6",
    "@types/trusted-types": "^2.0.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-compress": "^1.0.1",
    "esm": "^3.2.25",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.1",
    "jsdom-global": "^3.0.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "8.x",
    "showdown": "^2.1.0",
    "ts-jest": "^29",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yarn": "^1.22.22",
    "zlib": "^1.0.5"
  },
  "scripts": {
    "postinstall": "./cp2static.sh",
    "typecheck": "./node_modules/@typescript/native/bin/tsc",
    "lint": "oxlint --deny-warnings client tests esbuild.mjs md2html.js static/8queens.js static/cardgame.js static/service-worker.js",
    "lint:fix": "oxlint --fix client tests esbuild.mjs md2html.js static/8queens.js static/cardgame.js static/service-worker.js",
    "format": "oxfmt client tests esbuild.mjs md2html.js static/8queens.js static/cardgame.js static/service-worker.js",
    "check-format": "oxfmt --check client tests esbuild.mjs md2html.js static/8queens.js static/cardgame.js static/service-worker.js",
    "dev": "node esbuild.mjs dev",
    "prod": "node esbuild.mjs prod",
    "md": "./md2html.sh",
    "heroku-postbuild": "yarn run prod && yarn run md",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "files": [
    "/client",
    "!/**/*.test.*"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "\\.[jt]sx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/client/$1",
      "^gettext": "gettext.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!ffish-es6|ffish-alice-es6|chessgroundx|preact)"
    ]
  }
}
